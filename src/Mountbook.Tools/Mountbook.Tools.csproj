<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Deliberately NOT the plugin's TFM: this tool must prove the same thing the test project
         proves, that a data-side helper needs nothing from Dalamud or the game. -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Mountbook.Tools</RootNamespace>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Compiled by path, exactly like Mountbook.Tests: a Dalamud type reaching Services/ fails this
    build as well. `dotnet run` on this project is how tools/patch-day.ps1 runs the validator, so
    the checker and the plugin share one implementation of every rule.
  -->
  <ItemGroup>
    <Compile Include="..\Mountbook\Services\**\*.cs" LinkBase="Linked\Services" />
  </ItemGroup>
</Project>
