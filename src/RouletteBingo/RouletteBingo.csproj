<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.0.1</Version>
    <Author>Deepseek</Author>
    <Name>Roulette Bingo</Name>
    <Punchline>A bingo card for whatever the duty finder throws at you.</Punchline>
    <Description>A 5x5 bingo card generated for every duty you enter, filled with the small disasters and rituals of Final Fantasy XIV party content.

Click squares as they happen. The plugin auto-detects a few of them - deaths, wipes, vuln stacks, the chat classics - and leaves the rest to your honour and your memory. Get five in a row, copy the run report to your clipboard, and share cards with friends.

Every card is seeded, so the same seed always produces the same card. Copy a card code, send it to a friend, and they can play the exact same board.</Description>
    <RepoUrl>https://github.com/KazimeirzOdnowiciel/ffxiv-plugins</RepoUrl>
    <Tags>bingo;roulette;fun;social;meme;duty;card</Tags>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\squares.json" />
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <Compile Remove="preview\**" />
  </ItemGroup>
</Project>
